# ==============================================================================
# WORKAHOLIC WEB CLIENT ENVIRONMENT TEMPLATE (apps/web/.env.example)
# Conforms to docs/6.SYSTEM-ARCHITECTURE.md & docs/13.UX-SPECIFICATION.md
# ==============================================================================
# Copy this file to apps/web/.env or apps/web/.env.local
# NOTE: All variables prefixed with VITE_ are embedded into the client JavaScript bundle.
# NEVER PUT PRIVATE KEYS, SERVICE ACCOUNT SECRETS, OR GOOGLE_CLIENT_SECRET HERE!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API CONNECTION
# ------------------------------------------------------------------------------
# Backend API Base URL. Leave empty to rely on Vite's local dev server reverse proxy (/api -> :3001)
# Scope: Frontend | Secret: NO | Default: "" (proxied)
VITE_API_URL=

# ------------------------------------------------------------------------------
# 2. FIREBASE WEB SDK (Client Authentication & Google Sign-In)
# ------------------------------------------------------------------------------
# Generated from Firebase Console:
# 1. Go to Project Settings -> General -> "Your apps"
# 2. Add or select Web app (</>)
# 3. Copy the firebaseConfig values into the fields below:
#
# NOTE: If these values are not supplied, the app provides a "Local Demo Login" button
# that allows full navigation and testing with mock identities in development mode.
# Scope: Frontend (Public Web SDK credentials) | Secret: NO

VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_FIREBASE_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_FIREBASE_PROJECT_ID.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_FIREBASE_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID

# Optional: Firebase Auth Emulator Host for local offline testing (e.g., localhost:9099)
VITE_FIREBASE_AUTH_EMULATOR_HOST=
