# ==============================================================================
# WORKAHOLIC BACKEND API ENVIRONMENT TEMPLATE (apps/backend/.env.example)
# Conforms to docs/6.SYSTEM-ARCHITECTURE.md & docs/12.PRIVACY-SECURITY.md
# ==============================================================================
# Copy this file to apps/backend/.env or project root .env
# NEVER commit real secret values to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RUNTIME & SERVER NETWORKING
# ------------------------------------------------------------------------------
# Target execution environment ('development', 'production', 'test')
# Scope: Backend | Secret: NO | Default: development
NODE_ENV=development

# TCP Port on which Fastify HTTP server listens
# Scope: Backend | Secret: NO | Default: 3001
PORT=3001

# Network interface address Fastify binds to (0.0.0.0 allows container/local access)
# Scope: Backend | Secret: NO | Default: 0.0.0.0
HOST=0.0.0.0

# CORS Allowed Origin: URL of the web client for CORS headers and cookie validation
# Scope: Backend | Secret: NO | Default: http://localhost:5173
CLIENT_URL=http://localhost:5173

# Logging verbosity level ('fatal', 'error', 'warn', 'info', 'debug', 'trace', 'silent')
# Scope: Backend | Secret: NO | Default: info
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. POSTGRESQL 16 AUTHORITATIVE SYSTEM OF RECORD
# ------------------------------------------------------------------------------
# Authoritative PostgreSQL connection string. Format: postgresql://[user]:[password]@[host]:[port]/[database]
# Scope: Backend | Secret: YES (contains database password)
DATABASE_URL=postgresql://workaholic:workaholic_dev_secret@localhost:5432/workaholic_dev

# Connection pool sizing & timeout parameters
# Scope: Backend | Secret: NO
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000
DB_STATEMENT_TIMEOUT=30000

# ------------------------------------------------------------------------------
# 3. CRYPTOGRAPHIC KEYS & SYSTEM SECRETS
# ------------------------------------------------------------------------------
# 32-byte secret key used for AES-256-GCM encryption of integration tokens & session hashes
# Generate locally via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Scope: Backend | Secret: YES (CRITICAL: Never expose to frontend)
ENCRYPTION_KEY=workaholic_dev_32byte_secret_key_replace_in_production_12345

# Shared secret key passed in 'x-cron-secret' header to trigger background sync workers
# Scope: Backend | Secret: YES
CRON_SECRET=dev_cron_secret_replace_in_production

# ------------------------------------------------------------------------------
# 4. FIREBASE ADMIN SDK (Token Verification & Identity Authority)
# ------------------------------------------------------------------------------
# Generated from Firebase Console: Project Settings -> Service Accounts -> "Generate New Private Key"
# Note: For local offline/mock testing, leave empty. The backend will permit mock test tokens.
# Scope: Backend | Secret: YES (FIREBASE_PRIVATE_KEY is highly sensitive)

# Firebase Project Identifier (e.g., 'workaholic-demo-12345')
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID

# Firebase Service Account Client Email (e.g., 'firebase-adminsdk-xxxxx@workaholic-demo.iam.gserviceaccount.com')
FIREBASE_CLIENT_EMAIL=YOUR_FIREBASE_CLIENT_EMAIL

# Firebase Service Account Private Key (PEM format).
# IMPORTANT: Replace actual newlines with escaped '\n' characters so it fits on a single line!
# Example: "-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgk...=\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY="YOUR_FIREBASE_PRIVATE_KEY"

# Optional: Firebase Auth Emulator Host (if running Firebase CLI local emulator)
# Example: localhost:9099
FIREBASE_AUTH_EMULATOR_HOST=

# ------------------------------------------------------------------------------
# 5. GOOGLE CLOUD OAUTH 2.0 (Calendar, Tasks, Drive Integrations)
# ------------------------------------------------------------------------------
# From Google Cloud Console: APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Application Type: "Web application"
# Authorized redirect URIs: http://localhost:3001/api/v1/auth/google/callback
# Scope: Backend | Secret: GOOGLE_CLIENT_SECRET is YES (Never expose to frontend)

GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/auth/google/callback
