# ==============================================================================
# WORKAHOLIC AUTHORITATIVE MONOREPO ENVIRONMENT TEMPLATE (.env.example)
# Personal Productivity Operating System (Phases 0-21 Hackathon Demo)
# Conforms to docs/6.SYSTEM-ARCHITECTURE.md & docs/12.PRIVACY-SECURITY.md
# ==============================================================================
# Copy this file to '.env' at the repository root for monorepo development.
# Dotenv in Fastify automatically loads this root .env file.
# Vite in apps/web automatically loads VITE_* variables from the workspace root or apps/web.
#
# CRITICAL SECURITY RULES:
# 1. NEVER commit real secret credentials or private keys to git (.gitignore enforces this).
# 2. NEVER put SERVICE ACCOUNT PRIVATE KEYS or GOOGLE_CLIENT_SECRET into VITE_* variables.
# 3. All VITE_* variables are bundled directly into frontend JavaScript and are public.
# ==============================================================================

# ==============================================================================
# SECTION A: BACKEND FASTIFY API CONFIGURATION
# ==============================================================================

# Target environment: 'development', 'production', or 'test'
# Scope: Backend | Secret: NO | Default: development
NODE_ENV=development

# TCP Port on which the Fastify HTTP REST API server listens
# Scope: Backend | Secret: NO | Default: 3001
PORT=3001

# Network host address Fastify binds to (0.0.0.0 enables local Docker/LAN binding)
# Scope: Backend | Secret: NO | Default: 0.0.0.0
HOST=0.0.0.0

# CORS Allowed Origin: URL of the web client for CORS headers and cookie validation
# Scope: Backend | Secret: NO | Default: http://localhost:5173
CLIENT_URL=http://localhost:5173

# Logging verbosity level ('fatal', 'error', 'warn', 'info', 'debug', 'trace', 'silent')
# Scope: Backend | Secret: NO | Default: info
LOG_LEVEL=info

# ==============================================================================
# SECTION B: POSTGRESQL 16 AUTHORITATIVE SYSTEM OF RECORD
# ==============================================================================

# PostgreSQL ACID database connection URI: postgresql://[user]:[password]@[host]:[port]/[db]
# Scope: Backend | Secret: YES (contains database password)
DATABASE_URL=postgresql://workaholic:workaholic_dev_secret@localhost:5432/workaholic_dev

# Connection pool sizing & timeout parameters (in milliseconds)
# Scope: Backend | Secret: NO
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000
DB_STATEMENT_TIMEOUT=30000

# ==============================================================================
# SECTION C: ENCRYPTION & SYSTEM KEYS
# ==============================================================================

# 32-byte secret key used for AES-256-GCM encryption of integration refresh tokens
# Generate locally via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Scope: Backend | Secret: YES (CRITICAL: Never expose to frontend)
ENCRYPTION_KEY=workaholic_dev_32byte_secret_key_replace_in_production_12345

# Shared secret key passed in 'x-cron-secret' header to trigger background sync workers
# Scope: Backend | Secret: YES
CRON_SECRET=dev_cron_secret_replace_in_production

# ==============================================================================
# SECTION D: FIREBASE ADMIN SDK (Backend Authentication Authority)
# ==============================================================================
# Required for verifying Firebase ID tokens from the frontend.
# Obtain from Firebase Console:
# 1. Project Overview -> Project Settings -> Service accounts
# 2. Click "Generate new private key"
# 3. Either save the downloaded JSON file in your project root OR map individual fields:
#
# Scope: Backend | Secret: YES (Service account credentials are highly sensitive)

# Option 1 (Recommended & easiest - avoids multiline newline escaping):
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Option 2 (Manual field mapping from downloaded JSON):
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
FIREBASE_CLIENT_EMAIL=YOUR_FIREBASE_CLIENT_EMAIL
FIREBASE_PRIVATE_KEY="YOUR_FIREBASE_PRIVATE_KEY"

# Optional: Host:port of local Firebase Auth emulator (e.g., localhost:9099)
FIREBASE_AUTH_EMULATOR_HOST=

# ==============================================================================
# SECTION E: GOOGLE CLOUD OAUTH 2.0 (Calendar, Tasks, Drive Integrations)
# ==============================================================================
# Required for connecting user Google accounts for 2-way sync of Calendar, Tasks, and Drive.
# Obtain from Google Cloud Console:
# 1. APIs & Services -> Credentials -> Create Credentials -> OAuth client ID
# 2. Application type: "Web application"
# 3. Name: "Workaholic Local Dev"
# 4. Authorized redirect URIs:
#    http://localhost:3001/api/v1/auth/google/callback
#
# Enabled APIs required in Google Cloud Console:
# - Google Calendar API
# - Google Tasks API
# - Google Drive API
#
# Scope: Backend | Secret: GOOGLE_CLIENT_SECRET is YES (Never expose to frontend)

GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/auth/google/callback

# ==============================================================================
# SECTION F: FRONTEND WEB CLIENT (Vite / React 18)
# ==============================================================================
# All variables in this section MUST start with VITE_ to be exposed to the browser.
# DO NOT PUT PRIVATE KEYS OR SECRETS HERE.
#
# Obtain from Firebase Console -> Project Settings -> General -> "Your apps" -> Web app (</>)
# Scope: Frontend (Browser) | Secret: NO

VITE_API_URL=
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_FIREBASE_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_FIREBASE_PROJECT_ID.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_FIREBASE_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
VITE_FIREBASE_AUTH_EMULATOR_HOST=
