# Workaholic Environment Configuration Template
# Copy this file to .env for local development

NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Authoritative PostgreSQL Database
DATABASE_URL=postgresql://workaholic:workaholic_dev_secret@localhost:5432/workaholic_dev

# Internal Background Job Secret (used for securing scheduled cron endpoints)
CRON_SECRET=local_cron_secret_key_change_in_production

# Client Application URL
CLIENT_URL=http://localhost:5173

# Logging Level (debug, info, warn, error)
LOG_LEVEL=info
